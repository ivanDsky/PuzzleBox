  "cards": [
    {
      "dot": "cyan",
      "title": "Contracts",
      "items": [
        "Repository interfaces live in core; features inject them via Koin",
        "refresh() is network-first and returns AppResult; observeHistory()/cached() never touch the network",
        "homeLayoutFor() is a pure function: two-pane needs Expanded width AND landscape",
        "Pinned at 7b8eeea383c6533c691e9370a32b6fece28fab2f — no git remote, local-only identity"
      ]
    },
    {
      "dot": "emerald",
      "title": "Persistence",
      "items": [
        "Room schema JSON exported under core/data/schemas on every version bump; destructive fallbacks disallowed",
        "DataStore owns puzzlebox.preferences_pb process-wide on a SupervisorJob scope"
      ]
    },
    {
      "dot": "rose",
      "title": "Security",
      "items": [
        "OkHttp redacts Authorization and Cookie from logcat",
        "AuthHeaderSource binding is NONE today; LinkedIn session headers arrive in Phase 1",
        "Retrofit base URL is a placeholder pending the real hosts"
      ]
    }
  ]
