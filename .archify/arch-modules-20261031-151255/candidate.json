  "cards": [
    {
      "dot": "cyan",
      "title": "Dependency rule",
      "items": [
        "Arrows never leave the inner box \u2014 core/game has zero Compose/Android imports",
        "Onboarding OR evolving a game never edits core/game (F1 \u00a72.1/\u00a75); a required core edit is an F1 design bug",
        "Inside games/zip: codec and renderer model depend on the engine's types (ZipPuzzle / ZipState) \u2014 see F2 \u00a71"
      ]
    },
    {
      "dot": "emerald",
      "title": "GamePlugin seam",
      "items": [
        "app collects List<GamePlugin> from Koin \u2014 one registration line per game",
        "Plugin = definition + rules + session + score + PURE renderer-model factory (F2-1 amendment: Compose mapping lives in core/game-ui)",
        "PuzzleSource adapters today: LinkedInDaily (production) + test fake; games-archive later = third, additive (ADR-0002)"
      ]
    },
    {
      "dot": "rose",
      "title": "Records",
      "items": [
        "CompletionRecord = puzzleRef + time + hints + open stats slot (ADR-0004)",
        "core/data stamps firstCompletedAt / isRecord \u2014 first win per puzzle is the record (A4/A5)"
      ]
    }
