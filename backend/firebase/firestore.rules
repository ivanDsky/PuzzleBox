rules_version = '2';

// PuzzleBox Firestore rules.
//
// Layout: leaderboards/{boardId}/entries/{uid}
//   boardId = "<gameId>_<ISO-day>" (e.g. "zip_2026-10-31") — one board per official
//   daily puzzle; one entry per uid (the first write wins, as with records).
//   Entries carry the full puzzleRef "<gameId>/<ISO-day>/<n>" and the score inputs.
//   Only the games in dailyGameIds() have daily boards, and only for a puzzle day in
//   [server UTC date - 2, server UTC date + 1] (ADR-0024): an explicit allow-list, not a
//   generic id pattern, because entries can never be deleted; no historical backfill.
//   A sixth daily game needs its id on that list and a deploy of this file.
//
// Posture (brief product decisions): deny-all default; reads authenticated; writes
// owner-only with sanity validation (timeMs > 0, hints >= 0, puzzleRef shape and
// board consistency). Immutable once written: replays and score edits can never
// land, so the board is first-win by construction.
//
// Layout: puzzles/{code} — one shared puzzle per share code, readable by id only;
//   created once by its author and never edited, except that the author may set
//   `unpublished` (a tombstone: the code is never reused, nothing is deleted).
// Layout: puzzles/{code}/entries/{uid} — that puzzle's board, in the daily entry format
//   with puzzleRef "custom/<gameId>/<code>"; closed once the puzzle is unpublished and
//   never open to the puzzle's author.
// Layout: authors/{uid} = {day, count, last?} — the author's publishes on one UTC day. Every
//   puzzle create must bump it in the same write, and the bump is capped at 20 per day.
//   `last` is the share code the bump is for; when present, the create must be for that code,
//   so one bump covers one create. Older clients omit it, and a doc without it is still valid.
//
// Layout (ADR-0026): matches/{code} — one async duel per share code, in its own namespace. Readable
//   by id (the invite card opens signed out); listed only by its participants. Created once with
//   a matchQuota bump; afterwards only claim, cancel, decline and progress updates; never deleted.
//   deadline = createdAt + deadlineHours; close = deadline + 6 h grace.
// Layout: matches/{code}/results/{legIndex}_{uid} — one write-once result per player and leg,
//   posted with that player's progress in the same batch, plus an optional `replay` (bytes, at most
//   12288). Sealed: readable by its owner, by a participant who has posted the same leg, and by any
//   participant once the match closes.
// Layout: matchQuota/{uid} = {day, count, last} — match creates on one UTC day, capped at 20;
//   `last` names the code the bump is for, so one bump covers one create.
// Layout (ADR-0029): users/{uid}/{kind}/{docId} — the account's own cloud space, owner-only (read, list,
//   write and delete) on the closed kinds completions, drafts, published, received, boards and replays.
//   Every write stamps updatedAt = request.time and carries only that kind's keys, with size caps.

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny-all default: every path not matched below is unreadable and unwritable.
    match /{document=**} {
      allow read, write: if false;
    }

    match /leaderboards/{boardId}/entries/{uid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && validEntry();

      // First write stands: no score edits, no deletes, no replay overwrites.
      allow update, delete: if false;

      // The four UTC days an entry may be for: server today -2, -1, 0 and +1 (ADR-0024).
      // Exact days, not a string range: a range would also admit a day that does not exist.
      function dailyWindowDays() {
        return [
          utcDay(request.time - duration.value(2, 'd')),
          utcDay(request.time - duration.value(1, 'd')),
          utcDay(request.time),
          utcDay(request.time + duration.value(1, 'd'))
        ];
      }

      function validEntry() {
        let entry = request.resource.data;
        let ref = entry.puzzleRef;
        return entry.formatVersion == 1
          && entry.uid == request.auth.uid
          && entry.displayName is string
          && entry.displayName.size() > 0
          && entry.displayName.size() <= 64
          && ref is string
          && ref.matches('^[a-z]+/[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])/[1-9][0-9]*$')
          && ref.split('/')[0] in dailyGameIds()
          && ref.split('/')[1] in dailyWindowDays()
          && ref.split('/')[0] + '_' + ref.split('/')[1] == boardId
          && entry.timeMs is int
          && entry.timeMs > 0
          && entry.hints is int
          && entry.hints >= 0
          && entry.completedAtMs is int
          && entry.completedAtMs > 0;
      }
    }

    match /puzzles/{code} {
      allow get: if true;
      allow list: if false;

      allow create: if request.auth != null
        && validPuzzle()
        && bumpsPublishQuota();

      allow update: if request.auth != null
        && resource.data.authorUid == request.auth.uid
        && resource.data.unpublished == false
        && request.resource.data.unpublished == true
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['unpublished']);

      allow delete: if false;

      function validPuzzle() {
        let puzzle = request.resource.data;
        let fields = ['formatVersion', 'gameId', 'variant', 'shareCodecVersion', 'payload',
          'title', 'authorName', 'note', 'authorUid', 'authorTimeMs', 'authorHints',
          'createdAt', 'unpublished'];
        return puzzle.keys().hasAll(fields)
          && puzzle.keys().hasOnly(fields)
          && isShareCode(code)
          && puzzle.formatVersion == 1
          && puzzle.gameId is string
          && puzzle.gameId.size() > 0
          && puzzle.gameId.size() <= 32
          && puzzle.variant is string
          && puzzle.variant.size() <= 64
          && puzzle.shareCodecVersion is int
          && puzzle.shareCodecVersion >= 1
          && puzzle.payload is string
          && puzzle.payload.size() > 0
          && puzzle.payload.size() <= 8192
          && puzzle.title is string
          && puzzle.title.size() > 0
          && puzzle.title.size() <= 60
          && puzzle.authorName is string
          && puzzle.authorName.size() <= 40
          && puzzle.note is string
          && puzzle.note.size() <= 140
          && puzzle.authorUid == request.auth.uid
          && puzzle.authorTimeMs is int
          && puzzle.authorTimeMs > 0
          && puzzle.authorHints is int
          && puzzle.authorHints >= 0
          && puzzle.createdAt == request.time
          && puzzle.unpublished == false;
      }

      // The author's quota doc must move by exactly one publish in this same write, and name
      // this puzzle when it records a `last`.
      function bumpsPublishQuota() {
        let author = /databases/$(database)/documents/authors/$(request.auth.uid);
        let before = exists(author) ? get(author).data : null;
        let after = getAfter(author).data;
        return isPublishQuotaBump(before, after) && (!('last' in after) || after.last == code);
      }
    }

    match /puzzles/{code}/entries/{uid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && validCustomEntry(get(/databases/$(database)/documents/puzzles/$(code)).data);

      // First write stands, as on the daily boards.
      allow update, delete: if false;

      function validCustomEntry(puzzle) {
        let entry = request.resource.data;
        return puzzle.unpublished == false
          && puzzle.authorUid != uid
          && entry.keys().hasOnly(['formatVersion', 'uid', 'displayName', 'puzzleRef',
            'timeMs', 'hints', 'completedAtMs'])
          && entry.formatVersion == 1
          && entry.uid == request.auth.uid
          && entry.displayName is string
          && entry.displayName.size() > 0
          && entry.displayName.size() <= 64
          && entry.puzzleRef == 'custom/' + puzzle.gameId + '/' + code
          && entry.timeMs is int
          && entry.timeMs > 0
          && entry.hints is int
          && entry.hints >= 0
          && entry.completedAtMs is int
          && entry.completedAtMs > 0;
      }
    }

    match /authors/{uid} {
      // The publish transaction reads its own quota doc before bumping it.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && isPublishQuotaBump(null, request.resource.data);

      allow update: if request.auth != null
        && request.auth.uid == uid
        && isPublishQuotaBump(resource.data, request.resource.data);

      allow delete: if false;
    }

    match /matches/{code} {
      allow get: if true;
      allow list: if request.auth != null && request.auth.uid in resource.data.participants;

      allow create: if request.auth != null
        && validNewMatch()
        && bumpsMatchQuota();

      allow update: if request.auth != null
        && (isClaim() || isCancel() || isDecline() || isProgress());

      allow delete: if false;

      function validNewMatch() {
        let m = request.resource.data;
        let uid = request.auth.uid;
        let fields = ['formatVersion', 'createdAt', 'deadlineHours', 'challengerUid', 'challengerName',
          'challengerPhoto', 'invitedUid', 'opponentUid', 'opponentName', 'opponentPhoto', 'participants',
          'legs', 'includeFriends', 'cancelled', 'declined', 'rematchOf', 'progress', 'claimedAt'];
        return m.keys().hasAll(fields)
          && m.keys().hasOnly(fields)
          && isShareCode(code)
          && m.formatVersion == 1
          && m.createdAt == request.time
          && m.deadlineHours in [24, 48]
          && m.challengerUid == uid
          && isPlayerName(m.challengerName)
          && isPhoto(m.challengerPhoto)
          && m.opponentUid == null
          && m.opponentName == null
          && m.opponentPhoto == null
          && m.claimedAt == null
          && (m.invitedUid == null || m.invitedUid is string)
          && m.participants == (m.invitedUid == null ? [uid] : [uid, m.invitedUid])
          && m.includeFriends is bool
          && (m.rematchOf == null || isShareCode(m.rematchOf))
          && m.cancelled == false
          && m.declined == false
          && m.progress is map
          && m.progress.size() == 0
          && validLegs(m.legs);
      }

      // Rules cannot loop, so the at most ten legs are checked unrolled; a leg past the end passes.
      // Kept lean: the 10-leg create sits close to the 1000-expression budget of one request.
      function validLegs(legs) {
        let n = legs.size();
        return legs is list
          && n >= 1
          && n <= 10
          && validLeg(legs[0])
          && (n < 2 || validLeg(legs[1])) && (n < 3 || validLeg(legs[2])) && (n < 4 || validLeg(legs[3]))
          && (n < 5 || validLeg(legs[4])) && (n < 6 || validLeg(legs[5])) && (n < 7 || validLeg(legs[6]))
          && (n < 8 || validLeg(legs[7])) && (n < 9 || validLeg(legs[8])) && (n < 10 || validLeg(legs[9]));
      }

      // Exactly {ref, authorUid}: a daily ref of a daily game, or a custom ref.
      function validLeg(leg) {
        let ref = leg.ref;
        return leg.keys().hasOnly(['ref', 'authorUid'])
          && leg.keys().size() == 2
          && ref is string
          && ((ref.matches('^[a-z]+/[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])/[1-9][0-9]*$')
              && ref.split('/')[0] in dailyGameIds())
            || ref.matches('^custom/[a-z]+/[0-9A-HJKMNP-TV-Z]{6}$'))
          && (leg.authorUid == null || leg.authorUid is string);
      }

      // The caller's matchQuota doc must move by exactly one create in this same write, for this code.
      function bumpsMatchQuota() {
        let quota = /databases/$(database)/documents/matchQuota/$(request.auth.uid);
        let before = exists(quota) ? get(quota).data : null;
        let after = getAfter(quota).data;
        return isMatchQuotaBump(before, after) && after.last == code;
      }

      // A non-challenger takes the open seat before the deadline; the seat is set once.
      function isClaim() {
        let before = resource.data;
        let after = request.resource.data;
        let uid = request.auth.uid;
        return uid != before.challengerUid
          && before.opponentUid == null
          && before.cancelled == false
          && before.declined == false
          && request.time < matchDeadline(before)
          && (before.invitedUid == null || before.invitedUid == uid)
          && after.diff(before).affectedKeys()
            .hasOnly(['opponentUid', 'opponentName', 'opponentPhoto', 'participants', 'claimedAt'])
          && after.opponentUid == uid
          && isPlayerName(after.opponentName)
          && isPhoto(after.opponentPhoto)
          && after.participants == (uid in before.participants
            ? before.participants
            : before.participants.concat([uid]))
          && after.claimedAt == request.time;
      }

      function isCancel() {
        let before = resource.data;
        return request.auth.uid == before.challengerUid
          && before.opponentUid == null
          && before.cancelled == false
          && request.resource.data.cancelled == true
          && request.resource.data.diff(before).affectedKeys().hasOnly(['cancelled']);
      }

      // Only before the claim: an invitee who took the seat cannot void the match by declining.
      function isDecline() {
        let before = resource.data;
        return before.invitedUid == request.auth.uid
          && before.opponentUid == null
          && before.declined == false
          && request.resource.data.declined == true
          && request.resource.data.diff(before).affectedKeys().hasOnly(['declined']);
      }

      // A player appends one leg index to their own progress, and that leg's result exists after
      // this write (it is posted in the same batch).
      function isProgress() {
        let before = resource.data;
        let after = request.resource.data;
        let uid = request.auth.uid;
        let old = before.progress.get(uid, []);
        let now = after.progress.get(uid, []);
        return (uid == before.challengerUid || uid == before.opponentUid)
          && before.cancelled == false
          && before.declined == false
          && after.diff(before).affectedKeys().hasOnly(['progress'])
          && after.progress.diff(before.progress).affectedKeys().hasOnly([uid])
          && now is list
          && now.size() == old.size() + 1
          && (old.size() == 0 || now[0:old.size()] == old)
          && now[old.size()] is int
          && existsAfter(/databases/$(database)/documents/matches/$(code)/results/$(string(now[old.size()]) + '_' + uid));
      }
    }

    match /matches/{code}/results/{resultId} {
      // A result that exists: its owner, or a participant it is unsealed for. A result that does not exist:
      // any participant, so the reader learns Missing; the match's progress already says who posted what.
      // For an absent doc the first two branches error on the null `resource`, and `error || true` is true.
      // The absent check is `!exists` rather than `resource == null`: the Rules Test API cannot send a null
      // resource, so only this form is pinned by the matrix.
      allow get: if request.auth != null
        && (resource.data.uid == request.auth.uid
          || mayReadSealed(get(/databases/$(database)/documents/matches/$(code)).data)
          || (!exists(/databases/$(database)/documents/matches/$(code)/results/$(resultId))
            && request.auth.uid in get(/databases/$(database)/documents/matches/$(code)).data.participants));
      allow list: if false;

      allow create: if request.auth != null
        && validResult(
          get(/databases/$(database)/documents/matches/$(code)).data,
          getAfter(/databases/$(database)/documents/matches/$(code)).data);

      // Write once: no edits, no deletes.
      allow update, delete: if false;

      // A participant reads an opponent's leg once their own result for it exists, or after close.
      function mayReadSealed(m) {
        let uid = request.auth.uid;
        return uid in m.participants
          && (request.time >= matchCloses(m)
            || exists(/databases/$(database)/documents/matches/$(code)/results/$(string(resource.data.legIndex) + '_' + uid)));
      }

      // [m] is the match before this write, [after] the match after it (progress in the same batch).
      function validResult(m, after) {
        let result = request.resource.data;
        let uid = request.auth.uid;
        let fields = ['formatVersion', 'uid', 'legIndex', 'timeMs', 'hints', 'completedAtMs', 'gaveUp'];
        return result.keys().hasAll(fields)
          && result.keys().hasOnly(fields.concat(['replay']))
          && (!('replay' in result) || (result.replay is bytes && result.replay.size() <= 12288))
          && result.formatVersion == 1
          && result.uid == uid
          && result.legIndex is int
          && resultId == string(result.legIndex) + '_' + uid
          && result.legIndex >= 0
          && result.legIndex < m.legs.size()
          && (uid == m.challengerUid || uid == m.opponentUid)
          && m.cancelled == false
          && m.declined == false
          && request.time < matchCloses(m)
          && result.completedAtMs is int
          && result.completedAtMs > 0
          && result.completedAtMs <= m.createdAt.toMillis() + m.deadlineHours * 3600000
          && result.gaveUp is bool
          && result.timeMs is int
          && (result.gaveUp ? result.timeMs == 0 : result.timeMs > 0)
          && result.hints is int
          && result.hints >= 0
          && result.legIndex in after.progress.get(uid, []);
      }
    }

    match /matchQuota/{uid} {
      // The create batch reads its own quota doc before bumping it.
      allow get: if request.auth != null && request.auth.uid == uid;
      allow list: if false;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && isMatchQuotaBump(null, request.resource.data);

      allow update: if request.auth != null
        && request.auth.uid == uid
        && isMatchQuotaBump(resource.data, request.resource.data);

      allow delete: if false;
    }

    match /users/{uid}/{kind}/{docId} {
      // The account's own cloud space (ADR-0029): its owner reads, lists, writes and deletes, on the
      // closed list of kinds below, and nobody else touches it. Reads cover the owner's own collection
      // queries (`updatedAt >= cursor`); a query across accounts or kinds matches no rule.
      allow read, delete: if request.auth != null
        && request.auth.uid == uid
        && isSpaceKind();

      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && validSpaceDoc();

      function isSpaceKind() {
        return kind in ['completions', 'drafts', 'published', 'received', 'boards', 'replays'];
      }

      // Writes are merge-sets, so a tombstone written over a live doc leaves both shapes' keys; each
      // kind therefore lists the union of its live and tombstone keys once. Replays have no key list
      // yet, so they take no writes until their kind lands.
      function validSpaceDoc() {
        let d = request.resource.data;
        return d.updatedAt == request.time
          && d.formatVersion == 1
          && ((kind == 'completions' && validCompletionsDoc(d))
            || (kind == 'drafts' && validDraftDoc(d))
            || (kind == 'published' && validPublishedDoc(d))
            || (kind == 'received' && validReceivedDoc(d))
            || (kind == 'boards' && validBoardDoc(d)));
      }

      // One document per month, `yyyy-MM`, or `yyyy-MM-n` once the month overflows.
      function validCompletionsDoc(d) {
        return d.keys().hasOnly(['formatVersion', 'updatedAt', 'records'])
          && d.keys().hasAll(['records'])
          && docId.matches('^[0-9]{4}-(0[1-9]|1[0-2])(-[0-9]+)?$')
          && d.records is map
          && d.records.size() <= 1000;
      }

      function validDraftDoc(d) {
        return d.keys().hasOnly(['formatVersion', 'updatedAt', 'gameId', 'variant', 'draftFormatVersion', 'name',
            'blob', 'editedAtMs', 'deleted', 'deletedAtMs'])
          && (d.keys().hasAll(['gameId', 'variant', 'draftFormatVersion', 'name', 'blob', 'editedAtMs'])
            || isTombstone(d))
          && isSpaceName(d.get('name', ''))
          && (!('blob' in d) || (d.blob is bytes && d.blob.size() <= 65536));
      }

      function validPublishedDoc(d) {
        return d.keys().hasOnly(['formatVersion', 'updatedAt', 'gameId', 'name', 'publishedAtMs', 'unpublished'])
          && d.keys().hasAll(['gameId', 'name', 'publishedAtMs', 'unpublished'])
          && isShareCode(docId)
          && isSpaceName(d.get('name', ''))
          && d.unpublished is bool;
      }

      // The live shape carries what opens the puzzle offline (gameId, variant, sharedFormatVersion, bytes), the
      // card's author fields and the post state. Only the first six keys below are required; the rest are
      // optional, so a doc without them still passes.
      function validReceivedDoc(d) {
        return d.keys().hasOnly(['formatVersion', 'updatedAt', 'gameId', 'variant', 'sharedFormatVersion', 'name',
            'senderName', 'authorUid', 'note', 'authorTimeMs', 'authorHints', 'difficulty', 'receivedAtMs',
            'bytes', 'postState', 'deleted', 'deletedAtMs'])
          && (d.keys().hasAll(['gameId', 'name', 'senderName', 'receivedAtMs', 'bytes', 'postState'])
            || isTombstone(d))
          && isShareCode(docId)
          && isSpaceName(d.get('name', ''))
          && isSpaceName(d.get('senderName', ''))
          && isSpaceName(d.get('variant', ''))
          && isSpaceName(d.get('difficulty', ''))
          && (!('authorUid' in d) || (d.authorUid is string && d.authorUid.size() <= 128))
          && (!('note' in d) || (d.note is string && d.note.size() <= 140))
          && (!('bytes' in d) || (d.bytes is bytes && d.bytes.size() <= 8192));
      }

      // One document per game, day and hashed LinkedIn profile; the rows are the board's connections.
      function validBoardDoc(d) {
        return d.keys().hasOnly(['formatVersion', 'updatedAt', 'game', 'day', 'profileKey', 'readAtMs',
            'complete', 'rows'])
          && d.keys().hasAll(['game', 'day', 'profileKey', 'readAtMs', 'complete', 'rows'])
          && d.complete is bool
          && d.rows is list
          && d.rows.size() <= 51;
      }

      function isTombstone(d) {
        return d.get('deleted', false) == true && d.deletedAtMs is int;
      }

      function isSpaceName(s) {
        return s is string
          && s.size() <= 64;
      }
    }

    function matchDeadline(m) {
      return m.createdAt + duration.value(m.deadlineHours, 'h');
    }

    // Results whose solve finished by the deadline may still be posted until the close.
    function matchCloses(m) {
      return m.createdAt + duration.value(m.deadlineHours + 6, 'h');
    }

    function isPlayerName(s) {
      return s is string && s.size() > 0 && s.size() <= 64;
    }

    function isPhoto(s) {
      return s == null || (s is string && s.size() <= 2048);
    }

    // [after] is [before] plus one publish today (UTC); a doc from an earlier day restarts at one.
    // The optional [last] is shaped like a share code.
    function isPublishQuotaBump(before, after) {
      let today = utcDay(request.time);
      return after.keys().hasAll(['day', 'count'])
        && after.keys().hasOnly(['day', 'count', 'last'])
        && after.day == today
        && after.count is int
        && after.count == (before != null && before.day == today ? before.count + 1 : 1)
        && (!('last' in after) || isShareCode(after.last))
        && after.count <= 20;
    }

    // [after] is [before] plus one match create today (UTC); a doc from an earlier day restarts at
    // one. [last] names the share code of the match the bump is for.
    function isMatchQuotaBump(before, after) {
      let today = utcDay(request.time);
      return after.keys().hasAll(['day', 'count', 'last'])
        && after.keys().hasOnly(['day', 'count', 'last'])
        && after.day == today
        && after.count is int
        && after.count == (before != null && before.day == today ? before.count + 1 : 1)
        && isShareCode(after.last)
        && after.count <= 20;
    }

    // The games with a daily board; FirestoreRulesAllowListTest pins it to the game registry.
    function dailyGameIds() {
      return ['zip', 'tango', 'queens', 'strands', 'minisudoku'];
    }

    function isShareCode(s) {
      return s is string && s.matches('^[0-9A-HJKMNP-TV-Z]{6}$');
    }

    function utcDay(time) {
      return string(time.year()) + '-' + twoDigits(time.month()) + '-' + twoDigits(time.day());
    }

    function twoDigits(n) {
      return (n < 10 ? '0' : '') + string(n);
    }
  }
}
