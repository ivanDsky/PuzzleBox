<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Lets the duel result poster see the network come back (ConnectivityManager default-network callback). -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Android 13+ runtime permission for the daily puzzle reminder; asked only from the Settings switch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Normal permission: lets the reminder alarm be set again after a restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Normal permission: on One UI the haptics play Vibrator effects, since it drops the touch-feedback kinds (#1686). -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:name=".PuzzleBoxApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PuzzleBox">

        <!-- singleTask: a tapped share link reaches the running app as a new intent
             instead of stacking a second copy of it. The https filter claims puzzle links
             (ShareCode.LINK_PREFIX, /p/) and duel links (ShareCode.MATCH_LINK_PREFIX, /m/);
             autoVerify checks it against the host's /.well-known/assetlinks.json.
             adjustResize: the window draws edge to edge, so the keyboard resizes nothing and
             screens read the IME inset themselves (the Studio scrolls above it); without it
             the system picks pan, sliding the top bar under the status bar, and below API 30
             reports no IME inset at all. -->
        <activity
            android:name=".MainActivity"
            android:theme="@style/Theme.PuzzleBox.Starting"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:host="puzzlebox-f3356.web.app" />
                <data android:pathPrefix="/p/" />
                <data android:pathPrefix="/m/" />
            </intent-filter>
            <!-- Plain-text shares (a puzzle's notation) reach MainActivity as an import. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- The reminder alarm's own broadcast, sent by explicit intent: nothing else may reach it. -->
        <receiver
            android:name=".reminder.ReminderAlarmReceiver"
            android:exported="false" />

        <!-- The system sends boot-completed and package-replaced; the alarm is lost on both, so it is set again. -->
        <receiver
            android:name=".reminder.ReminderRebootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
            The home-screen widget. Exported because the launcher binds to it, and disabled so the picker does not list it until the
            home-widget flag turns the component on. The system sends the update broadcast; boot and package-replaced redraw after a
            restart or an update.
        -->
        <receiver
            android:name=".widget.PuzzleBoxWidgetReceiver"
            android:enabled="false"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>

            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/puzzlebox_widget_info" />
        </receiver>

        <!-- The widget's own wake-up, sent by explicit intent: nothing else may reach it. -->
        <receiver
            android:name=".widget.WidgetAlarmReceiver"
            android:exported="false" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.share"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/share_paths" />
        </provider>
    </application>

</manifest>
