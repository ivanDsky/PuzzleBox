<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The web view's data directory holds the LinkedIn session cookie, so it,
     the LinkedIn and Final board databases (with their write-ahead-log side files; the latter holds other players' names), the link-state file, the
     cloud-sync state file and the Firestore SDK's disk cache (database plus -wal, -shm and
     -journal; it holds connections' names) stay on the device; everything else keeps backing up.
     Firestore file name: firestore.<persistenceKey>.<projectId>.<databaseId>, URL-encoded,
     key "[DEFAULT]", project from google-services.json, database "(default)". Rules exclude whole files, which
     is why the database is separate from the app's own. Keep in step with backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview" />
        <exclude domain="database" path="linkedin.db" />
        <exclude domain="database" path="linkedin.db-wal" />
        <exclude domain="database" path="linkedin.db-shm" />
        <exclude domain="database" path="final_boards.db" />
        <exclude domain="database" path="final_boards.db-wal" />
        <exclude domain="database" path="final_boards.db-shm" />
        <exclude domain="file" path="linkedin_link.preferences_pb" />
        <exclude domain="file" path="cloud_sync_state.preferences_pb" />
        <exclude domain="database" path="firestore.%5BDEFAULT%5D.puzzlebox-f3356.%28default%29" />
        <exclude domain="database" path="firestore.%5BDEFAULT%5D.puzzlebox-f3356.%28default%29-wal" />
        <exclude domain="database" path="firestore.%5BDEFAULT%5D.puzzlebox-f3356.%28default%29-shm" />
        <exclude domain="database" path="firestore.%5BDEFAULT%5D.puzzlebox-f3356.%28default%29-journal" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview" />
        <exclude domain="database" path="linkedin.db" />
        <exclude domain="database" path="linkedin.db-wal" />
        <exclude domain="database" path="linkedin.db-shm" />
        <exclude domain="database" path="final_boards.db" />
        <exclude domain="database" path="final_boards.db-wal" />
        <exclude domain="database" path="final_boards.db-shm" />
        <exclude domain="file" path="linkedin_link.preferences_pb" />
        <exclude domain="file" path="cloud_sync_state.preferences_pb" />
        <exclude domain="database" path="firestore.%5BDEFAULT%5D.puzzlebox-f3356.%28default%29" />
        <exclude domain="database" path="firestore.%5BDEFAULT%5D.puzzlebox-f3356.%28default%29-wal" />
        <exclude domain="database" path="firestore.%5BDEFAULT%5D.puzzlebox-f3356.%28default%29-shm" />
        <exclude domain="database" path="firestore.%5BDEFAULT%5D.puzzlebox-f3356.%28default%29-journal" />
    </device-transfer>
</data-extraction-rules>
