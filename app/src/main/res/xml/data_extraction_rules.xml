<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. The web view's data directory holds the LinkedIn session cookie, so it,
     the LinkedIn database (with its write-ahead-log side files) and the link-state file
     stay on the device; everything else keeps backing up. Rules exclude whole files, which
     is why the database is separate from the app's own. Keep in step with backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="app_webview" />
        <exclude domain="database" path="linkedin.db" />
        <exclude domain="database" path="linkedin.db-wal" />
        <exclude domain="database" path="linkedin.db-shm" />
        <exclude domain="file" path="linkedin_link.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="app_webview" />
        <exclude domain="database" path="linkedin.db" />
        <exclude domain="database" path="linkedin.db-wal" />
        <exclude domain="database" path="linkedin.db-shm" />
        <exclude domain="file" path="linkedin_link.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
