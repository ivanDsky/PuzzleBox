<?xml version="1.0" encoding="utf-8"?>
<!-- Queens: GameGlyphs.Queens in white on the violet accent disc. Hand-converted from the Compose glyph; edit both together. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <path
        android:fillColor="@color/shortcut_accent_violet"
        android:pathData="M0,12a12,12 0 1,0 24,0a12,12 0 1,0 -24,0Z" />
    <!-- The glyph is drawn at 0.8 so its round caps and dots clear the disc edge; the stroke is widened to keep 2dp on screen. -->
    <group
        android:pivotX="12"
        android:pivotY="12"
        android:scaleX="0.8"
        android:scaleY="0.8">
        <path
            android:pathData="M4.5 17L4 8.5 8.5 12 12 6 15.5 12 20 8.5 19.5 17ZM5 20H19"
            android:strokeColor="@color/shortcut_glyph"
            android:strokeWidth="2.5"
            android:strokeLineCap="round"
            android:strokeLineJoin="round" />
    </group>
</vector>
