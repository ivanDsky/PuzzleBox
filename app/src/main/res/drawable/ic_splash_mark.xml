<?xml version="1.0" encoding="utf-8"?>
<!-- Splash-only copy of ic_launcher_foreground in brand lime. The launcher icon keeps its own mark.
     288dp canvas: the 108-unit mark sits inside the splash's central 2/3 circle, as the foreground does.
     Wrapped in an animated-vector with no targets on purpose: the system pre-draws a plain drawable into
     a 108dp bitmap and upscales it 1.8x to the 192dp splash circle (soft edges), but draws an Animatable
     one live at the final size. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">
    <aapt:attr name="android:drawable">
        <vector
            android:width="288dp"
            android:height="288dp"
            android:viewportWidth="108"
            android:viewportHeight="108">
            <path
                android:pathData="M42,34 L66,34 A8,8 0 0 1 74,42 L74,66 A8,8 0 0 1 66,74 L42,74 A8,8 0 0 1 34,66 L34,42 A8,8 0 0 1 42,34 Z"
                android:strokeColor="@color/puzzlebox_splash_mark"
                android:strokeWidth="4"
                android:fillColor="#00000000" />
            <path
                android:pathData="M44,42 L50.5,42 A2,2 0 0 1 52.5,44 L52.5,50.5 A2,2 0 0 1 50.5,52.5 L44,52.5 A2,2 0 0 1 42,50.5 L42,44 A2,2 0 0 1 44,42 Z"
                android:fillColor="@color/puzzlebox_splash_mark" />
            <path
                android:pathData="M57.5,42 L64,42 A2,2 0 0 1 66,44 L66,50.5 A2,2 0 0 1 64,52.5 L57.5,52.5 A2,2 0 0 1 55.5,50.5 L55.5,44 A2,2 0 0 1 57.5,42 Z"
                android:fillColor="@color/puzzlebox_splash_mark" />
            <path
                android:pathData="M44,55.5 L50.5,55.5 A2,2 0 0 1 52.5,57.5 L52.5,64 A2,2 0 0 1 50.5,66 L44,66 A2,2 0 0 1 42,64 L42,57.5 A2,2 0 0 1 44,55.5 Z"
                android:fillColor="@color/puzzlebox_splash_mark" />
        </vector>
    </aapt:attr>
</animated-vector>
