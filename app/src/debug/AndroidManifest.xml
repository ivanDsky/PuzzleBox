<?xml version="1.0" encoding="utf-8"?>
<!-- The showkase AAR's ShowkaseBrowserActivity extends AppCompatActivity and crashes
     under the app's platform Material theme ("must use a Theme.AppCompat theme").
     It is no longer a launch target — the Catalog route hosts the custom browser
     (a plain ComponentActivity that runs under the app theme, ticket
     design-previews-08; fix round 1 removed the superseded standalone activity) —
     but the AAR class stays merged from the library, so it keeps the AppCompat
     theme override (dark variant, per ticket 07) to remain launchable, e.g. via adb. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity
            android:name="com.airbnb.android.showkase.ui.ShowkaseBrowserActivity"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            tools:replace="android:theme" />
    </application>
</manifest>
