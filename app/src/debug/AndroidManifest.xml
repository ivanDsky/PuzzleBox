<?xml version="1.0" encoding="utf-8"?>
<!-- The stock ShowkaseBrowserActivity stays merged from the showkase AAR and keeps
     its AppCompat theme override (dark variant) to remain launchable — e.g. via adb.
     The custom ShowkaseBrowserActivity was deleted with the showkase-v2 cutover: the
     custom browser is an inline composable on the Catalog route under the app theme. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity
            android:name="com.airbnb.android.showkase.ui.ShowkaseBrowserActivity"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            tools:replace="android:theme" />
        <!-- Host activity for Robolectric compose tests (RealGamesPlayRouteTest et al.):
             compose-ui-test-manifest only merges into unit-test manifests, but app-module
             Robolectric tests parse the app's debug manifest, so register it here too. -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="true" />
        <!-- ShareTarget (M5-10-b): plain-text shares reach MainActivity in debug builds
             only; it merges into the main manifest's activity. M5-22 moves this filter to
             the main manifest, so release APKs stay out of the share sheet until then. -->
        <activity android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>
    </application>
</manifest>
