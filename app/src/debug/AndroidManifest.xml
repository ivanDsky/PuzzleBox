<?xml version="1.0" encoding="utf-8"?>
<!-- The stock ShowkaseBrowserActivity stays merged from the showkase AAR and keeps
     its AppCompat theme override (dark variant) to remain launchable — e.g. via adb.
     The custom ShowkaseBrowserActivity was deleted with the showkase-v2 cutover: the
     custom browser is an inline composable on the Catalog route under the app theme. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <activity
            android:name="com.airbnb.android.showkase.ui.ShowkaseBrowserActivity"
            android:theme="@style/Theme.AppCompat.NoActionBar"
            tools:replace="android:theme" />
        <!-- Host activity for Robolectric compose tests (ProfileScreenTest et al.):
             compose-ui-test-manifest only merges into unit-test manifests, but app-module
             Robolectric tests parse the app's debug manifest, so register it here too. -->
        <activity
            android:name="androidx.activity.ComponentActivity"
            android:exported="true" />
    </application>
</manifest>
