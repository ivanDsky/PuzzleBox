<?xml version="1.0" encoding="utf-8"?>
<!-- Lets Macrobenchmark profile this release-like build over adb shell without making it debuggable. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <application>
        <profileable
            android:shell="true"
            tools:targetApi="q" />
        <!-- Benchmark build only: the Insights journeys seed their solve history through it (BenchmarkSeedProvider). -->
        <provider
            android:name="com.ivandsky.puzzlebox.app.benchmark.BenchmarkSeedProvider"
            android:authorities="${applicationId}.seed"
            android:exported="true" />
    </application>
</manifest>
